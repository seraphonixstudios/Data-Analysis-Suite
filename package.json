{
  "name": "data-analysis-suite",
  "version": "1.0.0",
  "description": "AI-powered Data Analysis Suite with visualization and insights",
  "main": "dist/main.js",
  "scripts": {
    "dev": "concurrently \"tsc -w\" \"nodemon dist/main\"",
    "build": "tsc && webpack --mode production",
    "start": "electron .",
    "test": "jest",
    "lint": "eslint src/**/*.{ts,tsx}",
    "typecheck": "tsc --noEmit",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "postinstall": "electron-builder install-app-deps"
  },
  "keywords": ["data-analysis", "ai", "visualization", "analytics"],
  "author": "Data Analysis Suite",
  "license": "MIT",
  "build": {
    "appId": "com.dataanalysis.suite",
    "productName": "Data Analysis Suite",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "index.html",
      "assets/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": "dmg"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64", "ia32"]
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "concurrently": "^8.0.0",
    "electron": "^26.0.0",
    "electron-builder": "^24.0.0",
    "eslint": "^8.0.0",
    "jest": "^29.0.0",
    "nodemon": "^3.0.0",
    "style-loader": "^3.0.0",
    "css-loader": "^6.0.0",
    "ts-loader": "^9.0.0",
    "typescript": "^5.0.0",
    "webpack": "^5.0.0",
    "webpack-cli": "^5.0.0"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "d3": "^7.0.0",
    "chart.js": "^4.0.0",
    "express": "^4.18.0",
    "multer": "^1.4.0",
    "csv-parser": "^3.0.0",
    "xlsx": "^0.18.0",
    "papaparse": "^5.4.0",
    "cors": "^2.8.0",
    "helmet": "^7.0.0",
    "dotenv": "^16.0.0",
    "axios": "^1.0.0"
  }
}